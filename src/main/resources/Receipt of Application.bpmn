  <ns3:BPMNDiagram id="sid-8c6474ef-91ec-4e6b-816e-80a8f468174d" name="Receipt of application" documentation="The receipt of application process describes the procedure for when an application is received. The applicant may possibly be invited to a job interview or the applicant will receive a rejection. This decision is made with the assistance of a decision table.&#10;&#10;">
